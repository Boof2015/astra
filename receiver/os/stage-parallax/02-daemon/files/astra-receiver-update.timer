# Daily receiver update check. OnBootSec clears first-boot churn (cloud-init, filesystem
# resize, reboot) before the first check; Persistent catches up devices that were powered off
# overnight; the randomized delay avoids a fleet stampeding the release API at 03:30 sharp.

[Unit]
Description=Daily Astra receiver update check

[Timer]
OnBootSec=10min
OnCalendar=03:30
RandomizedDelaySec=1h
Persistent=true

[Install]
WantedBy=timers.target

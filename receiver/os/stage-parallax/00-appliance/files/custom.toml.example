# Parallax OS first-boot setup.
#
# Rename this file to  custom.toml  and edit it BEFORE the first boot. It is processed once by
# the standard Raspberry Pi OS first-boot machinery (the same thing Raspberry Pi Imager's
# customization dialog drives — Imager just refuses to show that dialog for third-party
# images), then deleted because it contains credentials.
#
# On Ethernet you can skip the [wlan] section entirely. Without a [user] section there is no
# account to log in with — the receiver itself still runs, but SSH and the console won't work
# and the on-screen first-boot wizard will sit on any connected TV.
config_version = 1

[system]
hostname = "parallax"

[user]
name = "parallax"
password = "changeme"
password_encrypted = false

[ssh]
enabled = true
password_authentication = true

[wlan]
ssid = "YourWifiName"
password = "YourWifiPassword"
password_encrypted = false
country = "US"

[locale]
# timezone = "America/New_York"
# keymap = "us"

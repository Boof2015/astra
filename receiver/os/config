# pi-gen config for Parallax OS — the flashable Raspberry Pi appliance image for the Astra
# Parallax receiver. Sourced by pi-gen's build.sh (the CI workflow copies this file plus
# stage-parallax/ into a pinned pi-gen checkout; see .github/workflows/parallax-os-release.yml).
#
# User story: a `parallax` user is baked with a throwaway password (FIRST_USER_PASS is injected
# per-build by the workflow) and then LOCKED by the appliance stage — so nothing shipped is
# loginable, but the stock first-boot wizard never squats on tty1 where the TV kiosk lives.
# Wi-Fi arrives via the daemon's captive-portal AP setup ("Parallax-Setup"); power users can
# still set a real password / SSH keys with a custom.toml on the boot partition.
# ENABLE_SSH stays off like stock Pi OS.

IMG_NAME="ParallaxOS"
FIRST_USER_NAME="parallax"
DISABLE_FIRST_BOOT_USER_RENAME=1
# CRITICAL for AP onboarding: without a Wi-Fi country, raspberrypi-sys-mods ships the radio
# rfkill-blocked AND pi-gen writes WirelessEnabled=false into NetworkManager's state — the
# setup hotspot can never start (found the hard way on the first flash). US is the pragmatic
# default; AP channels 1–11 are legal nearly everywhere, and a future portal version can
# re-set the domain per user.
WPA_COUNTRY="US"
# The pinned pi-gen arm64 ref defaults to trixie (current Pi OS); stated here for determinism.
RELEASE="trixie"
# The workflow verifies the raw .img (loop-mount asserts) and xz's it afterwards.
DEPLOY_COMPRESSION="none"
# Stock avahi advertises the hostname → http://parallax.local/ (auto-renames on conflict).
# An Imager hostname override runs at first boot and wins, which is the desired behavior.
TARGET_HOSTNAME="parallax"
TIMEZONE_DEFAULT="UTC"
# Lite base (stage0-2) + the appliance stage. CI touches stage2/SKIP_IMAGES so only
# stage-parallax exports an image.
STAGE_LIST="stage0 stage1 stage2 stage-parallax"

{
  "name": "astra",
  "version": "0.5.2-beta",
  "description": "Audiophile music player with advanced visualization",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check:packaging-config": "node ./scripts/electron-builder/validate-config.cjs",
    "test:album-grouping": "node --experimental-strip-types --experimental-default-type=module --test src/shared/library/albumGrouping.test.ts",
    "test:library-graph": "node --experimental-strip-types --experimental-default-type=module --experimental-specifier-resolution=node --test src/renderer/utils/libraryGraph.test.ts",
    "typecheck": "tsc --noEmit",
    "build:native": "cd native && node-gyp rebuild",
    "rebuild:native": "node -e \"const e=require('electron/package.json').version;const a=process.arch;const{execSync}=require('child_process');execSync('node-gyp rebuild --target='+e+' --arch='+a+' --dist-url=https://electronjs.org/headers',{stdio:'inherit',cwd:'native'})\"",
    "postinstall": "npm run rebuild:native || echo 'Native build failed, will use JS fallback'",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Boof2015/astra"
  },
  "keywords": [
    "music",
    "player",
    "audio",
    "visualizer",
    "electron"
  ],
  "author": {
    "name": "Boof2015",
    "email": "contact@novaml.ai"
  },
  "license": "GPL-3.0-only",
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "music-metadata": "^11.10.6",
    "node-addon-api": "^8.5.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-window": "^2.2.7",
    "sql.js": "^1.13.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "electron": "^40.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "node-gyp": "^10.3.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "build": {
    "appId": "com.astra.musicplayer",
    "productName": "Astra",
    "directories": {
      "output": "dist"
    },
    "afterPack": "./scripts/electron-builder/afterPack-prune-ffprobe.cjs",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**"
    ],
    "files": [
      "out/**/*",
      ".env.local",
      "native/build/Release/*.node",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*"
    ],
    "extraResources": [
      {
        "from": "native/build/Release/",
        "to": "native/",
        "filter": [
          "*.node"
        ]
      }
    ],
    "win": {
      "fileAssociations": [
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "role": "Viewer",
          "ext": [
            "mp3",
            "flac",
            "wav",
            "ogg",
            "aac",
            "m4a",
            "opus",
            "wma",
            "aiff",
            "alac",
            "ape",
            "wv"
          ]
        }
      ],
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "fileAssociations": [
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "role": "Viewer",
          "ext": [
            "mp3",
            "flac",
            "wav",
            "ogg",
            "aac",
            "m4a",
            "opus",
            "wma",
            "aiff",
            "alac",
            "ape",
            "wv"
          ]
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.music",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist"
    },
    "linux": {
      "fileAssociations": [
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "mp3"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "flac"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "wav"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "ogg"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "aac"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "m4a"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "opus"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "wma"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "aiff"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "alac"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "ape"
        },
        {
          "name": "Astra Audio File",
          "description": "Audio file",
          "ext": "wv"
        }
      ],
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "resources/icon.png",
      "category": "Audio"
    },
    "dmg": {
      "background": "resources/background.png",
      "iconSize": 80,
      "iconTextSize": 12,
      "window": {
        "width": 540,
        "height": 440
      },
      "contents": [
        { "x": 130, "y": 220, "type": "file" },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

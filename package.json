{
  "name": "astra",
  "version": "0.1.0",
  "description": "Audiophile music player with advanced visualization",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "build:native": "cd native && node-gyp rebuild",
    "rebuild:native": "cd native && node-gyp rebuild --target=$(node -p \"require('electron/package.json').version\") --arch=x64 --dist-url=https://electronjs.org/headers",
    "postinstall": "npm run build:native || echo 'Native build failed, will use JS fallback'"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Boof2015/astra"
  },
  "keywords": [
    "music",
    "player",
    "audio",
    "visualizer",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "music-metadata": "^11.10.6",
    "node-addon-api": "^8.3.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sql.js": "^1.13.0",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "autoprefixer": "^10.4.23",
    "electron": "^40.0.0",
    "electron-vite": "^5.0.0",
    "node-gyp": "^10.3.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  }
}
